# ==============================================================================
# Environment Configuration — Krishna Patil Portfolio Backend
# Copy this file to `backend/.env` for local development. Never commit real secrets.
# ==============================================================================

# Server Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# GitHub Configuration
GITHUB_USERNAME=kriss2012
# Optional: GitHub Personal Access Token (classic, read-only: public_repo, read:user)
# Highly recommended on Render to increase rate limit from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=

# AI Twin ChatBot Keys (Choose one or both)
# Groq provides ultra-fast, free-tier LLM inference (Llama 3.1 8B Instant)
GROQ_API_KEY=
AI_MODEL=llama-3.1-8b-instant

# Google Gemini API key (Alternative free tier provider)
GEMINI_API_KEY=

# Optional SerpAPI key for web searches
SERPAPI_API_KEY=

# CORS & Frontend Origins
# In production, set to your frontend domain (e.g. https://your-portfolio.netlify.app)
# Or use * for open access
CORS_ORIGIN=*
FRONTEND_URL=

# Cache TTL Configuration (in seconds)
CACHE_TTL_PROFILE=21600       # 6 hours
CACHE_TTL_REPOSITORIES=3600   # 1 hour
CACHE_TTL_CONTRIBUTIONS=7200  # 2 hours
CACHE_TTL_ACTIVITY=600        # 10 minutes
CACHE_TTL_COMMITS=600         # 10 minutes

# Rate Limiting
CHAT_RATE_LIMIT_PER_MINUTE=20
